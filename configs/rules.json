{
  "version": "1.0.0",
  "task_rules": {
    "质量预测-B型轴承-刀具磨损": ["数据预处理", "特征提取", "回归预测"],
    "质量预测-B型轴承-表面粗糙度": ["数据预处理", "特征提取", "回归预测"],
    "故障诊断-B型轴承-健康状态": ["数据预处理", "特征提取", "分类识别"],
    "故障诊断-B型轴承-是否故障": ["数据预处理", "特征提取", "分类识别"],
    "寿命预测-B型轴承-剩余寿命": ["数据预处理", "特征提取", "回归预测"]
  },
  "actions": {
    "数据预处理": {"input": "原始数据", "output": "清洗数据", "kind": "时序去噪类", "default": "内置带通滤波与降采样"},
    "特征提取": {"input": "清洗数据", "output": "特征值", "kind": "时序编码类", "default": "模型内置特征编码或统计频域特征"},
    "回归预测": {"input": "特征值", "output": "预测值", "kind": "数值回归类"},
    "分类识别": {"input": "特征值", "output": "类别", "kind": "分类器类"},
    "信号预处理": {"input": "原始数据", "output": "清洗数据", "kind": "自适应滤波类", "default": "内置预处理"},
    "瞬态特征提取": {"input": "清洗数据", "output": "频域信号", "kind": "时频变换类", "default": "频域特征"},
    "烧伤状态识别": {"input": "频域信号", "output": "状态数组", "kind": "二分类器类"},
    "烧伤程度评估": {"input": "状态数组", "output": "预测值", "kind": "数值回归类"}
  }
}
